{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ViLink Calculadora",
  "version": "1.0.0",
  "identifier": "com.vilink.calculadora",
  "build": {
    "frontendDist": ".."
  },
  "app": {
    "windows": [
      {
        "title": "ViLink Calculadora",
        "width": 1024,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 720,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/henry.w@example.net",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "shortDescription": "ViLink Calculadora - Armado LED",
    "longDescription": "Herramienta de campo para calcular gabinetes, data, power, truss y aparejos"
  }
}
